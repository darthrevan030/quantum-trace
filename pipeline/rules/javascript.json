{
  "language": "javascript",
  "extensions": {
    ".js": "javascript", ".mjs": "javascript", ".cjs": "javascript", ".jsx": "javascript",
    ".ts": "typescript", ".mts": "typescript", ".cts": "typescript", ".tsx": "typescript"
  },
  "skip": ["\\.min\\.js$", "\\.bundle\\.js$", "\\.d\\.[mc]?ts$", "(^|/)(dist|build|coverage)/"],
  "commentPrefixes": ["//", "/*", "*"],
  "rules": [
    {
      "id": "js-node-cipher",
      "regex": "\\bcreate(?:Cipheriv|Decipheriv|Cipher|Decipher)\\(\\s*['\"`]([\\w-]+)['\"`]",
      "algorithm": "{1}",
      "purpose": "encryption"
    },
    {
      "id": "js-node-cipher-dynamic",
      "regex": "\\bcreate(?:Cipheriv|Decipheriv)\\(\\s*[A-Za-z_$][\\w$.]*",
      "algorithm": "?",
      "label": "Cipher (runtime-selected)",
      "reason": "Cipher algorithm is chosen at runtime; review the value passed here.",
      "purpose": "encryption"
    },
    {
      "id": "js-node-hash",
      "regex": "\\b(?:createHash|crypto\\.hash)\\(\\s*['\"`]([\\w-]+)['\"`]",
      "algorithm": "{1}",
      "purpose": "hash"
    },
    {
      "id": "js-node-hmac",
      "regex": "\\bcreateHmac\\(\\s*['\"`]([\\w-]+)['\"`]",
      "algorithm": "hmac-{1}",
      "purpose": "hash"
    },
    {
      "id": "js-node-keypair",
      "regex": "\\bgenerateKeyPair(?:Sync)?\\(\\s*['\"`]([\\w-]+)['\"`]",
      "algorithm": "{1}",
      "lookahead": 8,
      "windowEnd": ")",
      "keySizePattern": "modulusLength\\s*:\\s*(\\d+)",
      "curvePattern": "namedCurve\\s*:\\s*['\"`]([\\w-]+)['\"`]"
    },
    {
      "id": "js-node-secret-key",
      "regex": "\\bgenerateKey(?:Sync)?\\(\\s*['\"`](aes)['\"`]",
      "algorithm": "{1}",
      "lookahead": 4,
      "windowEnd": ")",
      "keySizePattern": "length\\s*:\\s*(\\d+)",
      "purpose": "encryption"
    },
    {
      "id": "js-node-sign",
      "regex": "\\bcreate(?:Sign|Verify)\\(\\s*['\"`]([\\w-]+)['\"`]",
      "algorithm": "{1}",
      "classifyAs": "RSA",
      "label": "Signature ({1})",
      "reason": "Node createSign/createVerify only support RSA, DSA and EC keys, all vulnerable to Shor's algorithm.",
      "purpose": "signature"
    },
    {
      "id": "js-node-ecdh",
      "regex": "\\bcreateECDH\\(\\s*['\"`]([\\w-]+)['\"`]",
      "algorithm": "ECDH",
      "curveGroup": 1,
      "purpose": "keyExchange"
    },
    {
      "id": "js-node-dh",
      "regex": "\\b(?:createDiffieHellman(?:Group)?|getDiffieHellman)\\(\\s*(\\d+)?",
      "algorithm": "DH",
      "keySizeGroup": 1,
      "purpose": "keyExchange"
    },
    {
      "id": "js-node-rsa-encrypt",
      "regex": "\\b(?:publicEncrypt|privateDecrypt|privateEncrypt|publicDecrypt)\\(",
      "algorithm": "RSA",
      "purpose": "encryption"
    },
    {
      "id": "js-node-kdf",
      "regex": "\\b(pbkdf2|scrypt|hkdf)(?:Sync)?\\(",
      "algorithm": "{1}"
    },
    {
      "id": "js-webcrypto-digest",
      "regex": "\\bsubtle\\.digest\\(\\s*['\"`]([\\w-]+)['\"`]",
      "algorithm": "{1}",
      "purpose": "hash"
    },
    {
      "id": "js-webcrypto",
      "regex": "\\bsubtle\\.(?:generateKey|importKey|encrypt|decrypt|sign|verify|deriveKey|deriveBits|wrapKey|unwrapKey)\\(",
      "algorithmPattern": "['\"`](AES-(?:GCM|CBC|CTR|KW)|RSA-OAEP|RSA-PSS|RSASSA-PKCS1-v1_5|ECDSA|ECDH|HMAC|Ed25519|X25519|Ed448|X448|PBKDF2|HKDF|ML-KEM-\\d+|ML-DSA-\\d+)['\"`]",
      "lookahead": 6,
      "windowEnd": ")",
      "keySizePattern": "(?:length|modulusLength)\\s*:\\s*(\\d+)",
      "curvePattern": "namedCurve\\s*:\\s*['\"`]([\\w-]+)['\"`]",
      "hashPattern": "hash\\s*:\\s*(?:\\{\\s*name\\s*:\\s*)?['\"`](SHA-\\d+)['\"`]",
      "label": "WebCrypto (algorithm not visible)",
      "reason": "WebCrypto algorithm is passed by variable; review the value used here."
    },
    {
      "id": "js-tls-version",
      "regex": "\\b(?:minVersion|maxVersion)\\s*:\\s*['\"`](TLSv1(?:\\.[0-3])?)['\"`]",
      "algorithm": "{1}",
      "purpose": "protocol"
    },
    {
      "id": "js-tls-secure-protocol",
      "regex": "\\bsecureProtocol\\s*:\\s*['\"`]((?:TLSv1(?:_[1-3])?|SSLv[23]))_(?:client_|server_)?method['\"`]",
      "algorithm": "{1}",
      "purpose": "protocol"
    },
    {
      "id": "js-tls-ecdh-curve",
      "regex": "\\becdhCurve\\s*:\\s*['\"`]([\\w:-]+)['\"`]",
      "algorithm": "{1}",
      "split": ":",
      "dropUnknown": true,
      "purpose": "keyExchange"
    },
    {
      "id": "js-jwt-algorithm",
      "regex": "\\b(?:algorithm|alg)\\s*:\\s*['\"`]((?:HS|RS|ES|PS)(?:256|384|512)|EdDSA|none)['\"`]",
      "algorithm": "{1}",
      "label": "JWT {1}",
      "purpose": "signature"
    },
    {
      "id": "js-jwt-algorithms-list",
      "regex": "\\balgorithms\\s*:\\s*\\[([^\\]]*)\\]",
      "algorithm": "{1}",
      "split": "[\\s,'\"`]+",
      "dropUnknown": true,
      "label": "JWT {item}",
      "purpose": "signature"
    },
    {
      "id": "js-cryptojs",
      "regex": "\\bCryptoJS\\.(AES|DES|TripleDES|RC4|RC4Drop|Rabbit|MD5|SHA1|SHA224|SHA256|SHA384|SHA512|RIPEMD160|HmacMD5|HmacSHA1|HmacSHA256|HmacSHA384|HmacSHA512|PBKDF2)\\b",
      "algorithm": "{1}"
    },
    {
      "id": "js-cryptojs-module",
      "regex": "['\"`]crypto-js/(aes|tripledes|des|rc4|md5|sha1|sha256|sha512|hmac-sha1|hmac-sha256|hmac-md5|pbkdf2)['\"`]",
      "algorithm": "{1}"
    },
    {
      "id": "js-forge-rsa",
      "regex": "\\bpki\\.rsa\\.generateKeyPair\\(\\s*(\\d+)?",
      "algorithm": "RSA",
      "keySizeGroup": 1,
      "lookahead": 3,
      "windowEnd": ")",
      "keySizePattern": "bits\\s*:\\s*(\\d+)"
    },
    {
      "id": "js-forge-cipher",
      "regex": "\\bcipher\\.create(?:Cipher|Decipher)\\(\\s*['\"`]([\\w-]+)['\"`]",
      "algorithm": "{1}",
      "fileRequires": "node-forge",
      "purpose": "encryption"
    },
    {
      "id": "js-forge-md",
      "regex": "\\bforge\\.md\\.(md5|sha1|sha256|sha384|sha512)\\b",
      "algorithm": "{1}",
      "purpose": "hash"
    },
    {
      "id": "js-elliptic",
      "regex": "\\bnew\\s+(?:EC|ec|EdDSA|eddsa)\\(\\s*['\"`]([\\w-]+)['\"`]",
      "algorithm": "{1}",
      "fileRequires": "['\"`]elliptic['\"`]"
    },
    {
      "id": "js-noble-curves",
      "regex": "\\b(secp256k1|p256|p384|p521|ed25519|x25519|ed448|x448)\\.(?:sign|verify|getPublicKey|getSharedSecret)\\(",
      "algorithm": "{1}",
      "fileRequires": "@noble/curves"
    },
    {
      "id": "js-noble-hashes",
      "regex": "\\b(sha1|sha256|sha384|sha512|sha3_256|sha3_512|md5|ripemd160|blake2b|blake2s|blake3)\\(",
      "algorithm": "{1}",
      "fileRequires": "@noble/hashes",
      "purpose": "hash"
    },
    {
      "id": "js-post-quantum",
      "regex": "\\b(ml_kem(?:512|768|1024)|ml_dsa(?:44|65|87)|slh_dsa\\w*)\\.",
      "algorithm": "{1}"
    },
    {
      "id": "js-nacl",
      "regex": "\\bnacl\\.(box|sign|secretbox|scalarMult)\\b",
      "algorithmMap": {"box": "X25519", "sign": "Ed25519", "secretbox": "XSalsa20", "scalarmult": "X25519"}
    },
    {
      "id": "js-sodium",
      "regex": "\\bsodium\\.crypto_(box|sign|secretbox|kx|scalarmult|generichash|pwhash|aead_aes256gcm|aead_xchacha20poly1305_ietf|aead_chacha20poly1305(?:_ietf)?)",
      "algorithmMap": {
        "box": "X25519", "sign": "Ed25519", "secretbox": "XSalsa20", "kx": "X25519", "scalarmult": "X25519",
        "generichash": "BLAKE2b", "pwhash": "Argon2", "aead_aes256gcm": "aes-256-gcm",
        "aead_xchacha20poly1305_ietf": "chacha20", "aead_chacha20poly1305": "chacha20", "aead_chacha20poly1305_ietf": "chacha20"
      }
    },
    {
      "id": "js-password-hash",
      "regex": "\\b(bcrypt|argon2)\\.(?:hash|compare|verify|genSalt)(?:Sync)?\\(",
      "algorithm": "{1}"
    },
    {
      "id": "js-node-rsa",
      "regex": "\\bnew\\s+NodeRSA\\(",
      "algorithm": "RSA",
      "lookahead": 2,
      "windowEnd": ")",
      "keySizePattern": "\\bb\\s*:\\s*(\\d+)"
    },
    {
      "id": "js-mojaloop-jws",
      "regex": "\\bnew\\s+(?:JwsSigner|JwsValidator|Jws\\.signer|Jws\\.validator)\\(",
      "algorithm": "RS256",
      "classifyAs": "RSA",
      "label": "Mojaloop JWS (RS256/ES256)",
      "reason": "@mojaloop/sdk-standard-components signs FSPIOP messages with RS256, or ES256 for EC keys (jwsSigner.js); both are vulnerable to Shor's algorithm.",
      "purpose": "signature"
    },
    {
      "id": "js-algorithm-setting",
      "regex": "\\b(?:algorithm|cipher|cipherAlgorithm|hashAlgorithm|digest|digestAlgorithm|curve|namedCurve)\\s*[:=]\\s*['\"`]([\\w-]+)['\"`]",
      "algorithm": "{1}",
      "dropUnknown": true
    }
  ]
}
