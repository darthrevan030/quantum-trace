{
  "language": "python",
  "extensions": {".py": "python"},
  "commentPrefixes": ["#"],
  "rules": [
    {
      "id": "py-rsa-generate",
      "regex": "\\b(?:RSA\\.generate|algorithms\\.RSA)\\(\\s*(\\d+)?",
      "algorithm": "RSA",
      "keySizeGroup": 1
    },
    {
      "id": "py-rsa-private-key",
      "regex": "\\brsa\\.generate_private_key\\(",
      "algorithm": "RSA",
      "lookahead": 3,
      "windowEnd": ")",
      "keySizePattern": "key_size\\s*=\\s*(\\d+)"
    },
    {
      "id": "py-ec-curve",
      "regex": "\\bec\\.(SECP\\d+[RK]1|BrainpoolP\\d+R1)\\b",
      "algorithm": "EC",
      "curveGroup": 1
    },
    {
      "id": "py-edwards-montgomery",
      "regex": "\\b(Ed25519|X25519|Ed448|X448)PrivateKey\\.(?:generate|from_private_bytes)\\(",
      "algorithm": "{1}"
    },
    {
      "id": "py-dsa-dh",
      "regex": "\\b(dsa|dh)\\.generate_(?:private_key|parameters)\\(",
      "algorithm": "{1}"
    },
    {
      "id": "py-cryptography-cipher",
      "regex": "\\balgorithms\\.(AES|AES128|AES256|TripleDES|Blowfish|CAST5|IDEA|ARC4|Camellia|ChaCha20|SEED|SM4)\\(",
      "algorithm": "{1}",
      "purpose": "encryption"
    },
    {
      "id": "py-pycryptodome-cipher",
      "regex": "\\b(AES|DES3|DES|ARC4|ARC2|Blowfish|CAST|ChaCha20|Salsa20)\\.new\\(",
      "algorithm": "{1}",
      "purpose": "encryption"
    },
    {
      "id": "py-hashlib",
      "regex": "\\bhashlib\\.(md5|sha1|sha224|sha256|sha384|sha512|sha3_224|sha3_256|sha3_384|sha3_512|blake2b|blake2s)\\(",
      "algorithm": "{1}",
      "purpose": "hash"
    },
    {
      "id": "py-hashlib-new",
      "regex": "\\bhashlib\\.new\\(\\s*['\"]([\\w-]+)['\"]",
      "algorithm": "{1}",
      "purpose": "hash"
    },
    {
      "id": "py-cryptography-hash",
      "regex": "\\bhashes\\.(SHA1|SHA224|SHA256|SHA384|SHA512|SHA3_224|SHA3_256|SHA3_384|SHA3_512|MD5|BLAKE2b|BLAKE2s)\\(",
      "algorithm": "{1}",
      "purpose": "hash"
    },
    {
      "id": "py-hmac",
      "regex": "\\bhmac\\.(?:new|digest)\\([^)]*?(?:hashlib\\.|digestmod\\s*=\\s*['\"]|,\\s*['\"])(md5|sha1|sha224|sha256|sha384|sha512)",
      "algorithm": "hmac-{1}",
      "purpose": "hash"
    },
    {
      "id": "py-kdf",
      "regex": "\\b(PBKDF2HMAC|Scrypt|HKDF|Argon2id|pbkdf2_hmac|scrypt)\\(",
      "algorithm": "{1}"
    },
    {
      "id": "py-bcrypt",
      "regex": "\\bbcrypt\\.(?:hashpw|gensalt|checkpw)\\(",
      "algorithm": "bcrypt"
    },
    {
      "id": "py-ssl-protocol",
      "regex": "\\b(?:ssl\\.PROTOCOL_|TLSVersion\\.)(TLSv1(?:_[1-3])?|SSLv[23])\\b",
      "algorithm": "{1}",
      "purpose": "protocol"
    },
    {
      "id": "py-jwt",
      "regex": "\\balgorithm\\s*=\\s*['\"]((?:HS|RS|ES|PS)(?:256|384|512)|EdDSA|none)['\"]",
      "algorithm": "{1}",
      "label": "JWT {1}",
      "purpose": "signature"
    },
    {
      "id": "py-post-quantum",
      "regex": "\\b(kyber\\w*|ml[_-]?kem[_-]?\\d*|dilithium\\d?|ml[_-]?dsa[_-]?\\d*|sphincs\\w*|slh[_-]?dsa\\w*|falcon\\d*)",
      "flags": "i",
      "algorithm": "{1}"
    }
  ]
}
